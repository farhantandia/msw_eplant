# ==============================================================================
# MSW ePlant - Environment Configuration Template (.env.example)
# ==============================================================================
# Petunjuk:
# 1. Salin file ini menjadi `.env` di direktori root proyek:
#    cp .env.example .env
# 2. Isi nilai kredensial sesuai dengan environment Anda (Development / Production).
# 3. JANGAN PERNAH meng-commit file `.env` ke Git!
# ==============================================================================

# --- OpenWeatherMap API ---
# Dapatkan API key gratis di https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweathermap_api_key_here
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# --- Huawei FusionSolar Northbound OpenAPI ---
# Kredensial akun integrasi northbound portal Huawei FusionSolar
FUSIONSOLAR_BASE_URL=https://intl.fusionsolar.huawei.com/thirdData
FUSIONSOLAR_USERNAME=your_fusionsolar_username
FUSIONSOLAR_SYSTEM_CODE=your_fusionsolar_system_code
FUSIONSOLAR_STATION_MSW=NE=00000000
FUSIONSOLAR_STATION_KELANIS=NE=00000000

# --- Firebase Realtime Database ---
FIREBASE_RTDB_URL=https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app

# --- Microsoft Dynamics 365 (D365) Maintenance API ---
# Opsional: Base URL REST API integrasi D365 jika tersedia
D365_API_BASE_URL=
D365_API_TOKEN=

# --- Default Application Passwords (Role Access) ---
# Password default untuk peran otentikasi lokal
DEFAULT_ADMIN_PASSWORD=your_admin_password
DEFAULT_OPERATOR_PASSWORD=your_operator_password
DEFAULT_MAINTENANCE_PASSWORD=your_maintenance_password
DEFAULT_GENERAL_PASSWORD=your_general_password
DEFAULT_OKR_PASSWORD=your_okr_password
